From cdce3b457e73fef33eb297b3754119117f32de18 Mon Sep 17 00:00:00 2001
From: csmillie <csmillie@gmail.com>
Date: Mon, 9 Nov 2026 21:13:57 -0500
Subject: [PATCH 6/6] Add DKMS configuration

Build against the kernel DKMS is building for rather than the running
kernel. The Makefile defaults KVER to `uname -r`, so the upstream
dkms.conf would have built for the old kernel during a kernel upgrade
and left the new kernel without a driver.
---
 dkms.conf | 9 +++++++++
 1 file changed, 9 insertions(+)
 create mode 100644 dkms.conf

diff --git a/dkms.conf b/dkms.conf
new file mode 100644
index 0000000..4bfa818
--- /dev/null
+++ b/dkms.conf
@@ -0,0 +1,9 @@
+PACKAGE_NAME="ms912x"
+PACKAGE_VERSION="1.1"
+# The Makefile defaults to the running kernel; build for the one DKMS asks for.
+MAKE[0]="make KVER=${kernelver} all"
+CLEAN="make KVER=${kernelver} clean"
+BUILT_MODULE_NAME[0]="ms912x"
+BUILT_MODULE_LOCATION[0]=""
+DEST_MODULE_LOCATION[0]="/updates/dkms"
+AUTOINSTALL="yes"
-- 
2.56.0

